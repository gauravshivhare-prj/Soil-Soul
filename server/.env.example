# Soil & Soul server config. Copy to .env (never commit .env).

NODE_ENV=development
PORT=5000

# Comma-separated browser origins, no wildcard or paths. Production: https only.
CORS_ORIGIN=http://localhost:3000

# Required. Production must be encrypted: mongodb+srv:// or ?tls=true
#   Atlas: mongodb+srv://<username>:<password>@<cluster-host>/soilsoul_dev
MONGODB_URI=mongodb://127.0.0.1:27017/soilsoul_dev

# Optional: API requests per IP per 15 minutes (default 300)
# RATE_LIMIT_MAX=300

# Optional, production only: trusted proxy hops in front of the app (default 0)
# TRUST_PROXY=1
