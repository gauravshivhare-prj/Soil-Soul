# Soil & Soul server config. Copy to .env (never commit .env).

NODE_ENV=development
PORT=5000

# Comma-separated browser origins, no wildcard or paths. Production: https only.
CORS_ORIGIN=http://localhost:3000

# Required. Production must be encrypted: mongodb+srv:// or ?tls=true
#   Atlas: mongodb+srv://<username>:<password>@<cluster-host>/soilsoul_dev
MONGODB_URI=mongodb://127.0.0.1:27017/soilsoul_dev

# Required. JWT signing secret for access tokens (minimum 32 characters).
# Generate a strong key, e.g.: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# First-admin bootstrap only. Never expose or commit these values.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace_with_your_existing_admin_password

# Optional: Access token expiration (default 15m)
# JWT_ACCESS_EXPIRES_IN=15m

# Optional: refresh sessions (httpOnly cookie) keep users signed in across reloads and new tabs.
# Days a session lasts without use; each renewal extends it (default 7, max 90).
# REFRESH_TOKEN_TTL_DAYS=7
# Cookie SameSite: lax (default; shop and API on the same site) or none (different sites; HTTPS only).
# AUTH_COOKIE_SAMESITE=lax

# Optional: Authentication rate limit per IP per 15 minutes (default 20)
# AUTH_RATE_LIMIT_MAX=20

# Optional: API requests per IP per 15 minutes (default 300)
# RATE_LIMIT_MAX=300

# Optional, production only: trusted proxy hops in front of the app (default 0)
# TRUST_PROXY=1

# Optional: transactional email for verification and password-reset codes.
#   disabled (default) = nothing is sent; resend = Resend web API; gmail_smtp = Gmail SMTP with TLS.
#   The "test" provider is for automated tests only and is refused in production.
# EMAIL_PROVIDER=disabled
# EMAIL_FROM=Soil & Soul <your_gmail@gmail.com>
#
# When EMAIL_PROVIDER=resend:
# EMAIL_API_KEY=replace_with_your_resend_api_key
#
# When EMAIL_PROVIDER=gmail_smtp:
# SMTP_USER=your_gmail@gmail.com
# SMTP_APP_PASSWORD=replace_with_your_google_app_password
